# --- hh.ru ---
# Токен приложения (client_credentials). Виден в dev.hh.ru/admin после одобрения заявки.
# Без него поиск и просмотр вакансий недоступны, справочники работают.
HH_ACCESS_TOKEN=
# Контактная почта для заголовка User-Agent: hh требует её в каждом запросе.
HH_CONTACT_EMAIL=you@example.com
# Лимит запросов к hh в секунду и размер «пачки». hh не публикует лимитов — держимся скромно.
HH_RATE_PER_SEC=2
HH_BURST=4
# false — не брать системный прокси (HTTPS_PROXY): если VPN не пускает к hh.ru.
HH_TRUST_ENV=true

# --- файлы ---
# Резюме в Markdown. Относительный путь считается от корня проекта.
RESUME_PATH=resume.md
DB_PATH=data/career_mcp.sqlite

# --- LLM для extract_requirements (OpenAI-совместимый API) ---
# По умолчанию выключено: правила работают без LLM.
LLM_ENABLED=false
# Локально: Ollama. Внешний провайдер — на свой риск (п. 4.6 условий API hh, см. DECISIONS.md).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b-instruct
LLM_RATE_PER_MIN=5

# --- эмбеддинги (pip install -e ".[embeddings]") ---
EMBEDDINGS_ENABLED=false

# --- транспорт http ---
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
